<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_gt" model="ir.ui.view">
        <field name="name">product.template.form.gatherings.cotizacion</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Sitio web y cotizaciones (Gatherings)" name="gt_web">
                    <field name="gt_web_id"/>
                    <field name="gt_min_qty"/>
                    <field name="gt_unit_label"/>
                    <field name="gt_quote_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
