<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_gt" model="ir.ui.view">
        <field name="name">res.company.form.gatherings.cotizacion</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="gt_pago_texto" placeholder="Anticipo, cuentas y formas de pago que van al final de la cotización"/>
            </xpath>
        </field>
    </record>
</odoo>
