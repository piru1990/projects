<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gt_wa_compose_view_form" model="ir.ui.view">
        <field name="name">gt.wa.compose.form</field>
        <field name="model">gt.wa.compose</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="body" widget="text" placeholder="Escribí el mensaje o elegí una plantilla"/>
                </group>
                <footer>
                    <button name="action_open_whatsapp" type="object" class="btn-primary"
                            string="Abrir en WhatsApp" icon="fa-whatsapp"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
